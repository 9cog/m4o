    return createLink(TENSOR_FORWARD_LINK, atoms...);
}

template<typename ...Atoms>
inline Handle TensorTrain(Atoms const&... atoms) {
    return createLink(TENSOR_TRAIN_LINK, atoms...);
}

template<typename ...Atoms>
inline Handle RelationToTensor(Atoms const&... atoms) {
    return createLink(RELATION_TO_TENSOR_LINK, atoms...);
}

template<typename ...Atoms>
inline Handle TensorToRelation(Atoms const&... atoms) {
    return createLink(TENSOR_TO_RELATION_LINK, atoms...);
}

template<typename ...Atoms>
inline Handle DatalogToTensor(Atoms const&... atoms) {
    return createLink(DATALOG_TO_TENSOR_LINK, atoms...);
}

template<typename ...Atoms>
inline Handle BooleanMode(Atoms const&... atoms) {
    return createLink(BOOLEAN_MODE_LINK, atoms...);
}

template<typename ...Atoms>
inline Handle ContinuousMode(Atoms const&... atoms) {
    return createLink(CONTINUOUS_MODE_LINK, atoms...);
}



} // namespace opencog

#endif // _OPENCOG_ATOM_NAMES_H
