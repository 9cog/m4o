    DATALOG_TO_TENSOR_LINK = nameserver().declType(TENSOR_LOGIC_LINK, "DatalogToTensorLink", "DatalogToTensor");

    BOOLEAN_MODE_LINK = nameserver().declType(TENSOR_LOGIC_LINK, "BooleanModeLink", "BooleanMode");

    CONTINUOUS_MODE_LINK = nameserver().declType(TENSOR_LOGIC_LINK, "ContinuousModeLink", "ContinuousMode");


    
    nameserver().endTypeDecls();
}

// Static initializer to ensure types are registered
static struct AtomTypesInitializer {
    AtomTypesInitializer() { init_atom_types(); }
} _atom_types_initializer;

} // namespace opencog

#endif // _OPENCOG_ATOM_TYPES_INIT_H
